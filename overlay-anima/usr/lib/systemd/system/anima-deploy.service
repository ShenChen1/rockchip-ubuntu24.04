[Unit]
Description=Deploy ANIMA applications
RequiresMountsFor=/opt
AssertPathIsMountPoint=/opt

[Service]
Type=oneshot
RemainAfterExit=yes
# This root-owned launcher must finish writing service configuration before returning.
# Queue starts of units ordered after anima-deploy.target without blocking.
ExecCondition=/usr/bin/test -e /opt/anima-hub-runtime/start-hub.sh
ExecStart=/opt/anima-hub-runtime/start-hub.sh
ExecStartPost=/usr/bin/touch /run/anima-deploy.ready
ExecStartPost=/usr/bin/systemctl daemon-reload
# Enqueue dependencies added by deployment while the Hub still waits for us.
ExecStartPost=/usr/bin/systemctl --no-block start anima-hub.target
ExecStopPost=/usr/bin/rm -f /run/anima-deploy.ready
